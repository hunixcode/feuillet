# Obligatoires

# Adresse de la base MongoDB, en replica set (les ventes et les réceptions utilisent des transactions).
# En local : mongodb://localhost:27017/librairie?replicaSet=rs0 ; Atlas : mongodb+srv://<user>:<pass>@<cluster>/<db>
# Avec Docker Compose, cette valeur est remplacée par la base du conteneur.
MONGODB_URI=mongodb://localhost:27017/librairie?replicaSet=rs0
# Chaîne aléatoire d'au moins 32 caractères, elle signe les tokens de connexion.
JWT_SECRET=<chaine-aleatoire-de-32-caracteres-au-moins>
# Compte responsable de stock créé par `npm run seed`.
RESPONSABLE_EMAIL=<email-du-responsable>
RESPONSABLE_MOT_DE_PASSE=<mot-de-passe-du-responsable>

# Facultatives

PORT=3000
# production : sert le front compilé, HSTS, index MongoDB créés au démarrage
NODE_ENV=development
# Dossier du front compilé en production (par défaut frontend/dist)
DOSSIER_FRONT=
# Origines autorisées en CORS, séparées par des virgules, seulement si le front est servi ailleurs que l'API
CORS_ORIGINES=
# 1 derrière le proxy d'un hébergeur (IP réelle du client pour les limites de requêtes) ; vide en local
TRUST_PROXY=
