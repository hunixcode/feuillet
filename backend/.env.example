PORT=3000
# production : sert le front compilé, HSTS, index MongoDB créés au démarrage
NODE_ENV=development
# Facultatif : dossier du front compilé en production (par défaut frontend/dist)
DOSSIER_FRONT=
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
JWT_SECRET=<chaine-aleatoire-longue>
RESPONSABLE_EMAIL=<email-du-responsable>
RESPONSABLE_MOT_DE_PASSE=<mot-de-passe-du-responsable>
