PORT=3000
# production : active Strict-Transport-Security (HTTPS)
NODE_ENV=development
# Origines autorisées en CORS, séparées par des virgules, seulement si le front est servi ailleurs que l'API
CORS_ORIGINES=
# 1 derrière le proxy de Render (IP réelle du client pour les limites de requêtes) ; vide en local
TRUST_PROXY=
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
JWT_SECRET=<chaine-aleatoire-longue>
RESPONSABLE_EMAIL=<email-du-responsable>
RESPONSABLE_MOT_DE_PASSE=<mot-de-passe-du-responsable>
