@startuml 1_Cas_utilisation_librairie
!include style.iuml
left to right direction
skinparam usecase {
  BackgroundColor white
  BorderColor black
}

actor "Client" as C

rectangle "Système de gestion de librairie" {
  usecase "Consulter le catalogue" as UC_CAT
  usecase "Acheter des articles" as UC_ACH
  usecase "Demander un livre\nindisponible" as UC_DEM
  usecase "Vérifier la disponibilité" as UC_DISPO

  usecase "Suivre les commandes\net les retours" as UC_VENTE
  usecase "Gérer le catalogue" as UC_GCAT
  usecase "Gérer le stock et\nle réapprovisionnement" as UC_STOCK
  usecase "Produire un rapport" as UC_RAP
}

actor "Responsable\nde stock" as R

C -- UC_CAT
C -- UC_ACH
C -- UC_DEM

UC_CAT ..> UC_DISPO : <<include>>
UC_ACH ..> UC_DISPO : <<include>>
UC_DEM -[hidden]- UC_VENTE
UC_DEM -[hidden]- UC_GCAT
UC_DEM -[hidden]- UC_STOCK
UC_DEM -[hidden]- UC_RAP

UC_VENTE -- R
UC_GCAT -- R
UC_STOCK -- R
UC_RAP -- R
@enduml
